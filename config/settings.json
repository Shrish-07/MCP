{
  "models": {
    "decision": "claude-sonnet-5-5",
    "max_tokens": 4096,
    "send_temperature": false
  },
  "execution": {
    "dry_run": true,
    "mcp_url": "https://agent.robinhood.com/mcp/trading",
    "tradability_fail_mode": "closed",
    "min_dollar_volume": 75000000,
    "live_release_approved": false,
    "quote_max_age_seconds": 60,
