{
  "_description": "Catalog of Robinhood Trading MCP tools (server: execution.mcp_url in settings.json). REFERENCE ONLY — the agent does not read this file at runtime. 'used_by_agent' marks tools the current codebase actually calls; the rest are available on the server but dormant. Order-placing tools are only ever reached through ExecutionEngine's risk gates.",
  "transport": "streamable-https (OAuth 2.1 + PKCE, tokens cached in .rh_oauth_cache.json)",
  "account_scope": "account-scoped tools always target the account where agentic_allowed=true (see RobinhoodMCPClient._get_account_number)",
  "tools": {
    "get_accounts": { "category": "account", "account_scoped": false, "used_by_agent": true, "purpose": "List brokerage accounts; used to resolve the Agentic account number." },
    "get_portfolio": { "category": "account", "account_scoped": true, "used_by_agent": true, "purpose": "Account-level aggregates (total value, cash, buying power)." },
    "search": { "category": "discovery", "account_scoped": false, "used_by_agent": false, "purpose": "Instrument/ticker search." },

    "get_watchlists": { "category": "watchlists", "account_scoped": false, "used_by_agent": true, "purpose": "List watchlists (used to resolve the watchlist name for tickers)." },
    "get_watchlist_items": { "category": "watchlists", "account_scoped": false, "used_by_agent": true, "purpose": "Tickers in a named watchlist (fallback watchlist source)." },
    "get_option_watchlist": { "category": "watchlists", "account_scoped": false, "used_by_agent": false, "purpose": "Option watchlist contents." },
    "get_popular_watchlists": { "category": "watchlists", "account_scoped": false, "used_by_agent": false, "purpose": "Trending/popular watchlists." },
    "create_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Create a watchlist." },
    "update_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Update a watchlist." },
    "follow_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Follow a watchlist." },
    "unfollow_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Unfollow a watchlist." },
    "add_to_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Add instrument to watchlist." },
    "remove_from_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Remove instrument from watchlist." },
    "add_option_to_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Add option to watchlist." },
    "remove_option_from_watchlist": { "category": "watchlists-mutating", "account_scoped": false, "used_by_agent": false, "purpose": "Remove option from watchlist." },
    "get_equity_quotes": { "category": "equities", "account_scoped": false, "used_by_agent": true, "purpose": "Latest quotes (up to 20 symbols/call) — data ingest + 15s price monitor." },
    "get_equity_historicals": { "category": "equities", "account_scoped": false, "used_by_agent": true, "purpose": "OHLCV bars over an explicit RFC3339 start/end range." },
    "get_equity_fundamentals": { "category": "equities", "account_scoped": false, "used_by_agent": true, "purpose": "Fundamentals (sector, industry, market cap, P/E, yield) up to 10 symbols." },
    "get_equity_technical_indicators": { "category": "equities", "account_scoped": false, "used_by_agent": true, "purpose": "RSI / MACD / Bollinger / SMA / ATR computed server-side by Robinhood." },
    "get_equity_tradability": { "category": "equities", "account_scoped": true, "used_by_agent": true, "purpose": "Pre-trade tradability gate (fail-closed on error)." },
    "get_equity_tax_lots": { "category": "equities", "account_scoped": true, "used_by_agent": false, "purpose": "Per-lot tax lots for a holding." },

    "get_equity_positions": { "category": "positions-equities", "account_scoped": true, "used_by_agent": true, "purpose": "Live per-symbol holdings (merged into Portfolio.positions; reconciliation source)." },
    "get_equity_orders": { "category": "positions-equities", "account_scoped": true, "used_by_agent": false, "purpose": "Equity order history." },
    "review_equity_order": { "category": "trading-equities", "account_scoped": true, "used_by_agent": true, "purpose": "Pre-order preview; doubles as the dry-run 'order' (never places)." },
    "place_equity_order": { "category": "trading-equities", "account_scoped": true, "used_by_agent": true, "purpose": "LIVE order placement — only reached after every risk gate passes and execution.dry_run=false." },
    "cancel_equity_order": { "category": "trading-equities", "account_scoped": true, "used_by_agent": false, "purpose": "Cancel a live equity order (agent is market-order only)." },
    "get_option_chains": { "category": "options", "account_scoped": false, "used_by_agent": false, "purpose": "Option chain listing (equities-only agent today)." },
    "get_option_instruments": { "category": "options", "account_scoped": false, "used_by_agent": false, "purpose": "Option instrument metadata." },
    "get_option_quotes": { "category": "options", "account_scoped": false, "used_by_agent": false, "purpose": "Option quotes." },
    "get_option_positions": { "category": "options", "account_scoped": true, "used_by_agent": false, "purpose": "Open option positions." },
    "get_option_orders": { "category": "options", "account_scoped": true, "used_by_agent": false, "purpose": "Option order history." },
    "review_option_order": { "category": "options-trading", "account_scoped": true, "used_by_agent": false, "purpose": "Option order preview." },
    "place_option_order": { "category": "options-trading", "account_scoped": true, "used_by_agent": false, "purpose": "LIVE option order — never called by this agent." },
    "cancel_option_order": { "category": "options-trading", "account_scoped": true, "used_by_agent": false, "purpose": "Cancel option order." },

    "get_indexes": { "category": "indexes", "account_scoped": false, "used_by_agent": false, "purpose": "Index metadata." },
    "get_index_quotes": { "category": "indexes", "account_scoped": false, "used_by_agent": false, "purpose": "Index quotes." },
    "get_earnings_calendar": { "category": "events", "account_scoped": false, "used_by_agent": true, "purpose": "Earnings calendar (windowed) — feeds the informational earnings blocks." },
    "get_realized_pnl": { "category": "performance", "account_scoped": true, "used_by_agent": true, "purpose": "Realized P&L (attribution report)." },
    "get_pnl_trade_history": { "category": "performance", "account_scoped": true, "used_by_agent": true, "purpose": "Trade-by-trade P&L history (attribution report)." }
  }
}
