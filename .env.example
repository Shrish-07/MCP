# robinhood-agent environment variables - SECRETS ONLY.
#
# Every other setting (dry-run, schedule, watchlist, thresholds, model names,
# the Robinhood MCP URL, sentiment-selection flags, log level) lives in
# config/settings.json - the single source of truth for all toggles.

# Anthropic API key (LLM decisions)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Finnhub API key (news data)
FINNHUB_API_KEY=your_finnhub_api_key_here