# Robinhood MCP Trading Bot — Environment Variables (SECRETS ONLY)
# Copy this file to .env and fill in your values.
#
# ALL tunables and toggles (dry-run, thresholds, schedule, monitor speed,
# model names, cost pricing...) live in config/settings.json by design.
# Never put configuration here — only secrets.

# Anthropic API Key (powers all LLM decisions)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Finnhub API Key (news data)
FINNHUB_API_KEY=your_finnhub_api_key_here
